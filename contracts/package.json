{
  "name": "@qorewatch/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QoreWatchAttest: an account records on QoreChain that it checked its post-quantum health. Scaffolded from create-qorechain-dapp's foundry template.",
  "scripts": {
    "forge-std": "forge install foundry-rs/forge-std --no-git",
    "build": "forge build",
    "test": "forge test",
    "lint": "forge fmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "window": "tsx --env-file=.env scripts/window.ts",
    "deploy:testnet": "forge build && tsx --env-file=.env script/deploy.ts"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/sdk": "^0.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "viem": "^2.0.0"
  }
}
