# Testnet deployer for QoreWatchAttest. Use a fresh testnet-only account that has never
# held mainnet funds, fund it from https://dashboard.qorechain.io/faucet, and never commit .env.
# The deploy script derives the EVM key and the ML-DSA-87 key from this mnemonic.
QORE_MNEMONIC=

# testnet (qorechain-diana) or mainnet (qorechain-vladi), for `pnpm window` (template helper).
QORE_NETWORK=testnet

# Alternative for `pnpm window` only: PRIVATE_KEY plus a QRC1 recovery code instead of a mnemonic.
PRIVATE_KEY=
QORE_PQC_RECOVERY_CODE=
QORE_WINDOW_BLOCKS=600
QORE_WINDOW_TXS=5
