# QoreWatch site for Caddy (2.5 or newer). server-setup.sh writes this to /etc/caddy/conf.d/qorewatch.caddy
# with the domain filled in. Caddy gets and renews the HTTPS certificate by itself. No access log is
# written to disk (visitors' addresses stay out of files); Caddy's own messages go to the journal.
__DOMAIN__ {
	__TLS__
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# Caddy sets X-Forwarded-For to the real client address and drops one sent by the client,
	# so the bot's per-address rate limit cannot be dodged with a forged header.
	reverse_proxy 127.0.0.1:8787
}
