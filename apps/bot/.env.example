# QoreWatch bot settings. Copy to .env (never commit .env) and fill in the first two.

# From @BotFather. Secret: never paste it in a chat, a ticket or a commit. Rotate it in BotFather if it leaks.
TELEGRAM_BOT_TOKEN=
# The public HTTPS address that serves the link, fix and attest pages (your domain, through the reverse proxy).
PUBLIC_URL=https://qorewatch.example.com

# The bot's Telegram username, without @.
BOT_USERNAME=qorewatchbot
# testnet (qorechain-diana) or mainnet (qorechain-vladi).
QORE_NETWORK=testnet
# Optional: your own QoreChain node instead of the public endpoints.
QORE_RPC_URL=
QORE_REST_URL=
QORE_EVM_RPC_URL=

# The QoreWatchAttest contract (0x…), from contracts/deployments/qorechain-diana.json. Leave empty to disable /attest.
ATTEST_CONTRACT=

# Where the SQLite database lives. Back this folder up.
DATA_DIR=./data
# The HTTP server listens here; keep it on localhost behind the reverse proxy.
HTTP_HOST=127.0.0.1
HTTP_PORT=8787
# Optional: Telegram chat ids that get start-up notices, comma-separated.
ADMIN_CHAT_IDS=
# After an outage, scan at most this many past blocks (about 70 minutes at 1.4 s a block).
MAX_CATCHUP_BLOCKS=3000
POLL_MS=1500
LOG_LEVEL=info
# Optional: where the built web pages are (defaults to ../web/dist).
WEB_DIR=
